{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dinatalediego/Thinking-Patterns/schema/decision-case.schema.json",
  "title": "Decision Case",
  "type": "object",
  "required": [
    "decision_id",
    "question",
    "options",
    "selected_option_id"
  ],
  "properties": {
    "decision_id": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "selected_option_id": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string" },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "source"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "quality": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "falsifier": { "type": "string" },
          "consequence_if_false": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "expected_outcome": { "type": "string" },
    "success_metric": { "type": "string" },
    "review_by": { "type": "string" },
    "reversibility": {
      "type": "string",
      "enum": ["high", "medium", "low", "unknown"]
    },
    "rollback_trigger": { "type": "string" }
  },
  "additionalProperties": false
}
